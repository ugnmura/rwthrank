# Copy to backend.env on the box. Never commit the filled-in version.
#
# Without SMTP_HOST the app applies no mail settings at all, and PocketBase
# deletes an OTP whose email fails to send. That means an unconfigured
# deployment looks fine and silently issues codes nobody can use.
# Resend. SMTP_USERNAME is the literal string "resend"; the password is the
# API key. Sending is verified for the rwthrank.mindevice.net subdomain, which
# keeps its SPF away from the root record Cloudflare receiving depends on.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=

APP_NAME=rwthrank
APP_URL=https://api.rwthrank.mindevice.net
SENDER_NAME=rwthrank
SENDER_ADDRESS=noreply@rwthrank.mindevice.net

# Where the confirmation link in the email points. This is the GitHub Pages
# site, not this API, and without it the mail falls back to a plain code.
FRONTEND_URL=https://rwthrank.mindevice.net
